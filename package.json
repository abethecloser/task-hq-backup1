{
  "name": "task-management-hq",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run icons && tsc -b && vite build && vite build -c vite.extension.config.ts",
    "build:app": "tsc -b && vite build",
    "build:extension": "npm run icons && vite build -c vite.extension.config.ts",
    "icons": "node scripts/make-icons.mjs",
    "test": "node scripts/sync-functions.mjs && node --test src/core/*.test.ts src/adapter/*.test.ts src/automation/*.test.ts src/integrations/*.test.ts supabase/functions/dispatch/*.test.ts",
    "preview": "vite preview --host 0.0.0.0",
    "sync:functions": "node scripts/sync-functions.mjs",
    "test:intake:runner": "node --test scripts/intake-db/*.test.mjs",
    "test:intake:db": "node scripts/intake-db/run.mjs",
    "test:intake:ui": "node scripts/verify-intake-ui.mjs",
    "check:server": "node scripts/sync-functions.mjs && tsc -p tsconfig.server.json",
    "test:integration:db": "node scripts/intake-db/run.mjs"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@supabase/supabase-js": "2.117.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=20"
  }
}
